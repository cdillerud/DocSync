# DocSync / GPI Hub
# Keep source code visible. Ignore only dependencies, secrets, generated output,
# runtime data, caches, backups, and local tooling artifacts.

# Environment files and secrets
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*token.json*
*credentials.json*
*.pem

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.venv/
venv/
env/

# JavaScript / Node
node_modules/
**/node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Frontend and application builds
.next/
out/
build/
dist/
coverage/
*.tsbuildinfo
frontend/node_modules/.cache/

# IDE and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
.ipynb_checkpoints/

# Local deployment/tooling state
.vercel/
.cache/
chainlit.md
.chainlit/

# Runtime uploads and local databases
backend/uploads/
uploads/
*.db
*.sqlite
*.sqlite3
dump.rdb

# Generated production reports and diagnostics
/prod_reports/
/backend/scripts/prod_reports/
/test_reports/

# Production backup and recovery directories
/backups/
/recovery/
/recovered/

# Editor, patch, and manual backup artifacts
*.bak
*.save
*.orig
*.rej
*.tmp
*.temp
*~
*.swp
*.swo

# Generated archives and binary packages
*.zip
*.tar
*.tar.gz
*.tgz
*.pack
*.deb
*.dylib

# Local logs
*.log
logs/

# Local generated screenshots
.screenshots/

# Local diagnostic exports commonly produced by operations scripts
VENDOR_MISMATCH_SWEEP.json
VENDOR_MISMATCH_SWEEP.md
