                  </TextRun>
                  <TextRun>
                    <Value>=First(Fields!ReturnOrderNo.Value,"DataSet_Result")</Value>
                  </TextRun>
                </TextRuns>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Authorization Date: </Value>
                    <Style>
                      <FontWeight>Bold</FontWeight>
                      <Color>#8C1D18</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=Format(First(Fields!AuthorizationDate.Value,"DataSet_Result"),"MM/dd/yyyy")</Value>
                  </TextRun>
                </TextRuns>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Expected Return Date: </Value>
                    <Style>
                      <FontWeight>Bold</FontWeight>
                      <Color>#8C1D18</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=IIF(Year(First(Fields!ExpectedReturnDate.Value,"DataSet_Result"))=1,"",Format(First(Fields!ExpectedReturnDate.Value,"DataSet_Result"),"MM/dd/yyyy"))</Value>
                  </TextRun>
                </TextRuns>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Customer Reference: </Value>
                    <Style>
