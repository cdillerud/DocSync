# GPI Document Hub / Square9 parity UAT configuration
# Copy to backend/.env on the UAT host and populate secrets there.
# NEVER commit populated values. Sales / Inside Sales remain paused for this cutover.

# -------------------------------------------------------------------------------------------------
# Runtime / auth
# -------------------------------------------------------------------------------------------------
DEMO_MODE=false
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
MONGO_URL=mongodb://mongodb:27017
DB_NAME=gpi_document_hub

# -------------------------------------------------------------------------------------------------
# Microsoft Entra / Business Central
# Reads may use Production evidence. All writes remain pinned to Sandbox_NoZetadocs_UAT.
# -------------------------------------------------------------------------------------------------
TENANT_ID=
BC_CLIENT_ID=
BC_CLIENT_SECRET=
BC_COMPANY_ID=
BC_COMPANY_NAME=
BC_READ_ENVIRONMENT=Production
BC_WRITE_ENVIRONMENT=Sandbox_NoZetadocs_UAT
BC_BLOCK_PRODUCTION_WRITES=true
BC_MOCK_MODE=false
BC_WRITEBACK_LINK_ENABLED=true
BC_SALES_LINK_WRITE_ENABLED=false
BC_RETRY_MAX_ATTEMPTS=3
BC_RETRY_BASE_SECONDS=1.0

# -------------------------------------------------------------------------------------------------
# Square9 parity scope
# AP and Warehouse only. Keep every Sales / Inside Sales HTTP surface unreachable during UAT.
# -------------------------------------------------------------------------------------------------
ENABLE_OUT_OF_SCOPE_SALES_ROUTES=false

# -------------------------------------------------------------------------------------------------
# Microsoft Graph / SharePoint
# Test/UAT target only until cutover is explicitly authorized.
# App registration requires the Graph permissions used by the Hub (including SharePoint read/write).
# -------------------------------------------------------------------------------------------------
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
SHAREPOINT_TARGET=test
SHAREPOINT_BLOCK_PRODUCTION_WRITES=true
SHAREPOINT_SITE_HOSTNAME=gamerpackaging1.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/GPI-DocumentHub-Test
SHAREPOINT_LIBRARY_NAME=Shared Documents
SHAREPOINT_BASE_FOLDER=

# -------------------------------------------------------------------------------------------------
# Mailbox intake
# AP/Warehouse are in cutover scope. Do not enable Sales polling for this parity phase.
# -------------------------------------------------------------------------------------------------
EMAIL_CLIENT_ID=
EMAIL_CLIENT_SECRET=
EMAIL_TENANT_ID=
EMAIL_POLLING_ENABLED=false
EMAIL_POLLING_USER=
EMAIL_POLLING_INTERVAL_MINUTES=5
EMAIL_POLLING_LOOKBACK_MINUTES=60
EMAIL_POLLING_MAX_MESSAGES=25
EMAIL_POLLING_MAX_ATTACHMENT_MB=25
SALES_EMAIL_POLLING_ENABLED=false
SALES_EMAIL_POLLING_USER=

# -------------------------------------------------------------------------------------------------
# Optional AI/classification support. Deterministic parity rules remain authoritative.
# -------------------------------------------------------------------------------------------------
AI_CLASSIFICATION_ENABLED=true
AI_CLASSIFICATION_THRESHOLD=0.8
EMERGENT_LLM_KEY=
ENABLE_CREATE_DRAFT_HEADER=false

# -------------------------------------------------------------------------------------------------
# Frontend
# Leave blank for same-origin /api through the reverse proxy. If explicitly set, use HTTPS only.
# -------------------------------------------------------------------------------------------------
REACT_APP_BACKEND_URL=