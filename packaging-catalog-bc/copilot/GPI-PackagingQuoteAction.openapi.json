{
  "openapi": "3.0.3",
  "info": {
    "title": "GPI Packaging Quote Copilot Actions",
    "version": "1.0.0",
    "description": "Controlled Copilot-facing contract for preparing and executing Business Central packaging quote actions. Business Central remains authoritative for pricing, guardrails, approvals, quote status, and action eligibility."
  },
  "tags": [
    {
      "name": "Packaging Quote Actions",
      "description": "Prepare and execute controlled Business Central packaging quote actions."
    }
  ],
  "paths": {
    "/packagingQuoteActions/prepare": {
      "post": {
        "operationId": "PreparePackagingQuoteAction",
        "summary": "Prepare a packaging quote action",
        "description": "Reads current Business Central state, validates whether the requested action is currently available, and returns the confirmation payload. This operation does not change Business Central or Spiro.",
        "tags": [
          "Packaging Quote Actions"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrepareActionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current action preparation result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrepareActionResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/packagingQuoteActions/execute": {
      "post": {
        "operationId": "ExecutePackagingQuoteAction",
        "summary": "Execute a confirmed packaging quote action",
        "description": "Revalidates live Business Central state and the state-bound confirmation token, then delegates the actual write to the controlled Business Central action executor.",
        "tags": [
          "Packaging Quote Actions"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExecuteActionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Confirmed action executed and resulting Business Central state returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecuteActionResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PackagingQuoteAction": {
        "type": "string",
        "enum": [
          "evaluate",
          "readyForReview",
          "approve",
          "reject",
          "reopen"
        ],
        "description": "Exact Business Central bound action name."
      },
      "PrepareActionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "quoteNo",
          "action"
        ],
        "properties": {
          "quoteNo": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "description": "Business Central packaging quote entry number."
          },
          "action": {
            "$ref": "#/components/schemas/PackagingQuoteAction"
          }
        },
        "example": {
          "quoteNo": 55,
          "action": "reopen"
        }
      },
      "ExecuteActionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "quoteNo",
          "action",
          "confirmationToken"
        ],
        "properties": {
          "quoteNo": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "action": {
            "$ref": "#/components/schemas/PackagingQuoteAction"
          },
          "confirmationToken": {
            "type": "string",
            "minLength": 1,
            "description": "Exact state-bound token returned by the immediately preceding Prepare operation."
          }
        },
        "example": {
          "quoteNo": 55,
          "action": "reopen",
          "confirmationToken": "GPI-Q55-REOPEN-example"
        }
      },
      "PrepareActionResponse": {
        "type": "object",
        "required": [
          "schemaVersion",
          "mode",
          "quoteNo",
          "currentStatus",
          "requestedAction",
          "isAllowed",
          "confirmationRequired",
          "allowedWriteActions",
          "contractVersion",
          "writeExecution"
        ],
        "properties": {
          "schemaVersion": {
            "type": "string",
            "example": "1.0"
          },
          "mode": {
            "type": "string",
            "enum": [
              "Prepare"
            ]
          },
          "quoteNo": {
            "type": "integer",
            "format": "int32"
          },
          "quoteId": {
            "type": "string",
            "format": "uuid"
          },
          "customerNo": {
            "type": "string"
          },
          "customerName": {
            "type": "string"
          },
          "currentStatus": {
            "type": "string"
          },
          "requestedAction": {
            "$ref": "#/components/schemas/PackagingQuoteAction"
          },
          "isAllowed": {
            "type": "boolean"
          },
          "confirmationRequired": {
            "type": "boolean"
          },
          "confirmationText": {
            "type": "string",
            "nullable": true
          },
          "expectedResultStatus": {
            "type": "string",
            "nullable": true
          },
          "reason": {
            "type": "string",
            "nullable": true
          },
          "confirmationToken": {
            "type": "string",
            "nullable": true,
            "description": "Returned only when the action is permitted and confirmation is required."
          },
          "allowedWriteActions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PackagingQuoteAction"
            }
          },
          "contractVersion": {
            "type": "string"
          },
          "recommendedNextAction": {
            "type": "string"
          },
          "hasPricingExceptions": {
            "type": "boolean"
          },
          "primaryPricingExceptionStatus": {
            "type": "string"
          },
          "primaryPricingExceptionMessage": {
            "type": "string"
          },
          "primaryApprover": {
            "type": "string"
          },
          "writeExecution": {
            "$ref": "#/components/schemas/WriteExecutionPreparation"
          }
        }
      },
      "WriteExecutionPreparation": {
        "type": "object",
        "required": [
          "permitted",
          "executeMode",
          "confirmationTokenRequired"
        ],
        "properties": {
          "permitted": {
            "type": "boolean"
          },
          "executeMode": {
            "type": "string",
            "enum": [
              "Execute"
            ]
          },
          "confirmationTokenRequired": {
            "type": "boolean"
          }
        }
      },
      "ExecuteActionResponse": {
        "type": "object",
        "required": [
          "schemaVersion",
          "mode",
          "quoteNo",
          "requestedAction",
          "executed",
          "statusBefore",
          "statusAfter",
          "resultingAllowedWriteActions",
          "contractVersion"
        ],
        "properties": {
          "schemaVersion": {
            "type": "string",
            "example": "1.0"
          },
          "mode": {
            "type": "string",
            "enum": [
              "Execute"
            ]
          },
          "quoteNo": {
            "type": "integer",
            "format": "int32"
          },
          "quoteId": {
            "type": "string",
            "format": "uuid"
          },
          "requestedAction": {
            "$ref": "#/components/schemas/PackagingQuoteAction"
          },
          "executed": {
            "type": "boolean"
          },
          "statusBefore": {
            "type": "string"
          },
          "statusAfter": {
            "type": "string"
          },
          "expectedResultStatus": {
            "type": "string",
            "nullable": true
          },
          "resultingAllowedWriteActions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PackagingQuoteAction"
            }
          },
          "recommendedNextAction": {
            "type": "string"
          },
          "contractVersion": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Stable machine-readable error category."
          },
          "message": {
            "type": "string",
            "description": "Human-readable refusal or failure reason."
          },
          "quoteNo": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "action": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PackagingQuoteAction"
              }
            ],
            "nullable": true
          },
          "retryPrepare": {
            "type": "boolean",
            "description": "True when the caller should prepare again before attempting execution."
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Request failed validation or violates a hard safety boundary.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Conflict": {
        "description": "Current Business Central state no longer permits the requested operation or the confirmation token is stale.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "ServerError": {
        "description": "Unexpected integration or downstream Business Central failure.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    }
  },
  "x-gpi-implementation": {
    "milestone": "0.40",
    "environment": "Sandbox_NoZetadocs_UAT",
    "businessCentralAuthority": true,
    "prepareComponent": "Prepare-GPIPackagingQuoteActionUAT.ps1",
    "executeComponent": "Invoke-GPIPackagingQuoteActionUAT.ps1",
    "flowComponent": "Invoke-GPIPackagingQuoteCopilotFlowUAT.ps1",
    "protectedQuoteNumbers": [
      67
    ],
    "confirmationModel": "Prepare returns a state-bound confirmation token. Execute must receive that exact token and must revalidate live Business Central state before writing.",
    "hostingStatus": "Contract only. No hosted HTTP endpoint is created by milestone 0.40."
  }
}